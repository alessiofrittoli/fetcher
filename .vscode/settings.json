{
	"workbench.colorCustomizations": {
		"titleBar.activeBackground": "#00000000",
		"titleBar.border": "#8D37CB",
		"titleBar.activeForeground": "#F0F0F0",
		"statusBar.background": "#191919",
		"statusBar.border": "#8D37CB",
		"statusBar.foreground": "#F0F0F0",
		"activityBar.activeBorder": "#8D37CB",
		"activityBarBadge.foreground": "#F0F0F0",
		"activityBarBadge.background": "#8D37CB"
	},
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"files.associations": {
		".ignore": "ignore",
		".gitignore": "ignore"
	},
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"json.schemaDownload.trustedDomains": {
		"https://raw.githubusercontent.com/DavidAnson/markdownlint/": true
	}
}
